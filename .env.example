# Telegram
TELEGRAM_BOT_TOKEN=
WEBHOOK_BASE_URL=          # e.g. https://abc123.ngrok.app or https://<railway-domain> — leave blank to skip set_webhook
WEBHOOK_SECRET=changeme    # sent as X-Telegram-Bot-Api-Secret-Token header

# Storage
DB_PATH=./data/users.sqlite        # on Railway: /data/users.sqlite (volume-mounted)
DATA_DIR=./data
PORT=8080

# Backups (optional — leave R2_* blank to keep snapshots local-only)
BACKUP_ENABLED=false
BACKUP_DIR=./backups
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
